{
  "name": "pop-can-extension",
  "description": "Browser extension and local OpenAI-compatible server for web AI providers",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "predev": "npm run presets:build",
    "dev": "vite",
    "presets:build": "node scripts/build-presets.mjs",
    "presets:check": "node scripts/build-presets.mjs --check",
    "presets:check:strict": "node scripts/build-presets.mjs --check --strict",
    "presets:test": "node --test scripts/vite-plugin-preset-build.test.mjs",
    "fixtures:sanitize": "node scripts/sanitize-fixtures.mjs",
    "fixtures:privacy": "node scripts/check-fixture-privacy.mjs",
    "providers:capture-request": "node scripts/capture-provider-request.mjs",
    "provider-pack:build": "node scripts/build-provider-pack.mjs",
    "prebuild": "npm run presets:build",
    "build": "vite build"
  },
  "dependencies": {
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph": "^1.4.18",
    "@mozilla/readability": "^0.6.0",
    "debug": "^4.4.3",
    "dompurify": "^3.4.17",
    "jsonc-parser": "^3.3.1",
    "langchain": "^1.6.0",
    "marked": "^18.0.7",
    "turndown": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.1",
    "@scala-js/vite-plugin-scalajs": "^1.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.8"
  },
  "author": "just3bowls",
  "license": "MIT"
}
