          "[&_:is(a,button,[role=button]):focus-visible]:![outline:2px_solid_var(--dbd-theme-action-bg,var(--dbx-fill-highlight))]",
          "[&_:is(a,button,[role=button]):focus-visible]:!outline-offset-[-2px]",
          "pt-g-sidebar-wrapper-padding-top",
          "pl-g-sidebar-wrapper-padding-left",
          "pr-g-sidebar-wrapper-padding-right",
          "h-full"
        ],
        "capturedAt": 1795191552989,
        "classes": [
          "group/sidebar_nav_item",
          "cursor-pointer",
          "flex",
          "items-center",
          "px-8",
          "rounded-dbx-lg",
          "h-32",
          "!text-dbx-text-primary",
          "hover:bg-dbx-fill-trans-10-hover",
          "nav-link-IkIer0",
          "mb-2"
        ],
        "clickable": true,
        "docX": 140.00000476837158,
        "docY": 104.80000305175781,
