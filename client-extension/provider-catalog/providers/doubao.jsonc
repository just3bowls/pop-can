          "!border-none",
          "!bg-transparent",
          "max-h-[calc(var(--input-guidance-input-container-max-height)-var(--custom-area-height,0px)-36px-16px-14px-10px)]",
          "container-ObLj2X",
          "w-full"
        ],
        "capturedAt": 1795191552988,
