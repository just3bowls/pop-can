{
  // Doubao 网页 SSE：答案位于 block_type=10000 文本块，深度思考档会先出现 10040 思考块；规则通过 thinkStart/answerStart 阶段门把页面思考与最终答案分开。
  "schemaVersion": 1,
  "page": {
    // Doubao 使用 Tiptap/ProseMirror contenteditable 作为输入框，New Chat 在左侧导航；fingerprints 优先匹配编辑器角色、classes 与容器层级。
    "url": "https://www.doubao.com/chat",
    "selectors": {
      "input": "div.tiptap.ProseMirror[contenteditable=\"true\"]",
      "new-chat": "//div[@role='button' and contains(@class,'sidebar_nav_item')][.//*[contains(normalize-space(.),'新对话')]]"
    },
    "fingerprints": {
      "input": {
        "ancestorClasses": [
