      },
      "new-chat": {
        "ancestorClasses": [
          "select-none",
          "contents",
          "relative",
          "p-12",
          "sm:fixed",
          "overflow-hidden",
          "pointer-events-auto",
          "w-sidebar-width",
          "flex",
          "shrink-0",
          "flex-col",
          "bg-dbx-bg-base-web",
          "border-r",
          "border-[0.5px]",
          "border-s-color-border-tertiary/80",
