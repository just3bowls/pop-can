{
  // Longcat 标准 SSE：event.type=content 输出正文增量，event.type=finish 显式收尾。
  "schemaVersion": 1,
  "page": {
    // Longcat 使用 composer 内的可编辑输入区，New Chat 走页面导航；fingerprints 用于输入框与新建对话按钮的定位校准。
    "url": "https://longcat.chat/",
    "selectors": {
      "input": "/*[local-name()='html']/*[local-name()='body'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][2]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][2]/*[local-name()='div'][2]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]",
      "new-chat": "/*[local-name()='html']/*[local-name()='body'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][2]"
    },
    "fingerprints": {
      "input": {
        "ancestorClasses": [
          "editor-wapper",
          "my-mtd-textarea",
          "textarea-wrap"
        ],
        "capturedAt": 1790644227853,
        "classes": [
          "tiptap",
          "ProseMirror",
          "ProseMirror-focused"
        ],
        "docX": 774.8000183105469,
        "docY": 365.2437686920166,
        "editable": true,
        "height": 25.137500762939453,
        "innerHeight": 711,
        "innerWidth": 1298,
        "parentTag": "div",
        "role": "input",
        "tag": "div",
        "width": 762.4000244140625,
        "x": 774.8000183105469,
        "y": 365.2437686920166
      },
      "new-chat": {
        "ancestorClasses": [
          "slider-header",
          "v-slider-header",
          "slider-menus-content"
        ],
        "ancestorTexts": [
          "开启新对话",
          "开启新对话",
          "开启新对话下载手机应用请先登录简体中文"
        ],
        "capturedAt": 1790644226323,
        "classes": [
          "new-content"
        ],
        "docX": 80,
        "docY": 111,
        "height": 46,
        "innerHeight": 767,
        "innerWidth": 1298,
        "parentClasses": [
          "slider-header"
        ],
        "parentTag": "div",
        "role": "new-chat",
        "tag": "div",
        "text": "开启新对话",
        "width": 120,
        "x": 80,
        "y": 111
      }
    }
  },
  "network": {
    // 同时匹配 chat-completion-oversea-V2 与 chat-completion-V2 两个 SSE 端点，兼容页面路由差异。
    "apiPatterns": [
      "https://longcat.chat/api/v1/chat-completion-oversea-V2",
      "https://longcat.chat/api/v1/chat-completion-V2"
    ]
  },
  "attachment": {
    // file 模式使用 #file-upload-default 隐藏 input；固定 id 可避开随机化 class。
    "strategy": "input",
    "selector": "#file-upload-default"
  },
  "parserRule": {
    // Longcat SSE: `data: {...}` where `event.type` names the kind of frame.
    "schemaVersion": 1,
    "handlers": [
      {
        // event.type=content — a piece of the answer.
        "id": "answerDelta",
        "match": {
          // 匹配 event.type=content，读取 event.content 中的正文增量。
          "transport": "sse-json-line",
          "path": "$.event.type",
          "equals": "content"
        },
        "content": "$.event.content"
      },
      {
        // event.type=finish — the server finished this answer.
        "id": "finish",
        "match": {
          // 匹配 event.type=finish，作为服务端明确给出的正常结束信号。
          "transport": "sse-json-line",
          "path": "$.event.type",
          "equals": "finish"
        },
        "actions": [
          {
            // 将本轮标记为正常结束。
            "op": "setFinishReason",
            "value": "stop"
          }
        ]
      }
    ],
    "request": {
      // inline 模式改写请求体 $.content；该字段是 Longcat 当前用户输入。
      "userText": "$.content"
    }
  }
}
