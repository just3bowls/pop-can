{
  // GLM 网页 SSE：正文按增量输出，但 status=finish 帧会重复完整答案；规则用 appendDelta 吸收最终快照，并过滤页面渲染用的 turn/citation token。
  "schemaVersion": 1,
  "page": {
    // 输入框是 composer textarea，附件入口暴露 input.el-upload__input，New Chat 在页面主区域；fingerprints 用于校准文本框与新建对话入口。
    "url": "https://chatglm.cn/",
    "selectors": {
      "input": ".chat-textarea textarea",
      "new-chat": "button[aria-label=\"新对话\"][class*=\"sidebar-nav__item\"]"
    },
    "fingerprints": {
      "input": {
        "ancestorClasses": [
          "el-textarea",
          "chat-textarea",
          "input-area",
          "input-box-wrapper"
        ],
        "capturedAt": 1795191553930,
        "classes": [
          "el-textarea__inner"
        ],
        "docX": 772.6000061035156,
        "docY": 320.3999938964844,
        "editable": true,
        "height": 54,
        "innerHeight": 703,
        "innerWidth": 1283,
        "parentClasses": [
          "el-textarea",
          "chat-textarea"
        ],
        "parentTag": "div",
        "placeholder": "和我聊聊天吧～",
        "tag": "textarea",
        "width": 874.4000244140625,
        "x": 772.6000061035156,
        "y": 320.3999938964844
      },
      "new-chat": {
        "ancestorClasses": [
          "sidebar-nav",
          "sidebar-top-group",
          "flex",
          "min-h-0",
          "flex-1",
          "flex-col"
        ],
        "ariaLabel": "新对话",
        "capturedAt": 1795191553931,
        "classes": [
          "sidebar-nav__item",
          "el-tooltip__trigger",
          "el-tooltip__trigger"
        ],
        "clickable": true,
        "docX": 130.5999984741211,
        "docY": 76,
        "height": 32,
        "innerHeight": 703,
        "innerWidth": 1283,
        "parentClasses": [
          "sidebar-nav"
        ],
        "parentTag": "nav",
        "tag": "button",
        "text": "新对话",
        "width": 237.1999969482422,
        "x": 130.5999984741211,
        "y": 76
      }
    }
  },
  "network": {
    // 监听 /chatglm/backend-api/assistant/stream；这一家的引用和回合 token 只在页面渲染层有含义，没有额外 follow-up 网络源。
    "apiPatterns": [
      "https://chatglm.cn/chatglm/backend-api/assistant/stream"
    ]
  },
  "attachment": {
    // file 模式直接使用 composer 附件选择器下的隐藏 input；固定 selector 比自动择优更稳定，避免误选头像上传框。
    "strategy": "input",
    "selector": ".upload-attachment-picker > input.file-input"
  },
  "parserRule": {
    // GLM web SSE. Text streams as deltas, but the `status=finish` frame repeats the whole answer as a snapshot — and the deltas can stop early (dropping the closing markers), so that snapshot is the safety net. Provider-native turn and citation tokens are stripped because they are page-rendered chips with no URL metadata in the stream.
    "schemaVersion": 1,
    "contentTransforms": [
      {
        // The page renders this turn token as a source chip and the stream carries no URL mapping.
        "id": "dropTurnChip",
        "regex": "【turn\\d+(?:search|news|image)\\d+】",
        "replacement": "",
        "settle": {
          "candidatePrefix": "【turn"
        }
      },
      {
        // The page renders this citation token as a source chip and the stream carries no URL mapping.
        "id": "dropCitationChip",
        "regex": "【citation:\\d+】",
        "replacement": "",
        "settle": {
          "candidatePrefix": "【citation:"
        }
      }
    ],
    "handlers": [
      {
        // Normal streaming frames: a text part that is not the finish snapshot.
        "id": "gmlTextChunk",
        "match": {
          // Fan out parts and select the text content part by type; `status=finish` is handled below.
          "transport": "sse-json-line",
          "eventsPath": "$.parts[*]",
          "path": "$.content[?(@.type=='text')][0].type",
          "equals": "text",
          "allOf": [
            {
              // 非 finish 帧按增量追加；finish 快照留给后面的 handler 去重结算。
              "path": "$.status",
              "regex": "^(?!finish$)"
            }
          ]
        },
        "content": "$.content[?(@.type=='text')][0].text"
      },
      {
        // The finish frame repeats the whole text; appending it verbatim would duplicate the answer.
        "id": "gmlFinishSnapshot",
        "match": {
          // Only the `status=finish` frame.
          "transport": "sse-json-line",
          "eventsPath": "$.parts[*]",
          "path": "$.content[?(@.type=='text')][0].type",
          "equals": "text",
          "allOf": [
            {
              // 只让 status=finish 的最终快照进入这条结算路径。
              "path": "$.status",
              "equals": "finish"
            }
          ]
        },
        "actions": [
          {
            // appendDelta keeps only the tail beyond collected raw content; contentTransforms is the single normalization layer.
            "op": "appendDelta",
            "path": "$.content[?(@.type=='text')][0].text"
          }
        ]
      }
    ],
    "request": {
      // inline 模式改写最后一条消息中 type=text 的文本 part；只替换用户正文，不改其他多模态 part。
      "userText": "$.messages[-1].content[?(@.type=='text')][0].text"
    }
  }
}
