{
  // Wenxin 有两种聊天端点：经典 /aichat/api/conversation 与 agent /chat/api/agent/task_mode；不同模式的答案组件和增量语义不同，规则按 URL 明确分派。
  "schemaVersion": 1,
  "page": {
    // Wenxin 使用 textarea 作为输入框，New Chat 在页面导航；fingerprints 用于定位编辑器和新建对话入口。
    "url": "https://wenxin.baidu.com/",
    "selectors": {
      "input": "textarea#chat-textarea",
      "new-chat": "//span[contains(@class,'cos-line-clamp-1') and normalize-space()='新对话']"
    },
    "fingerprints": {
      "input": {
        "ancestorClasses": [
          "ci-file-input-wrapper",
          "ci-container"
        ],
        "capturedAt": 1795191554586,
        "classes": [
          "ci-textarea",
          "ci-scroll-style"
        ],
        "docX": 763.1000061035156,
        "docY": 603.9000244140625,
        "editable": true,
        "height": 30,
        "id": "chat-textarea",
        "innerHeight": 703,
        "innerWidth": 1283,
        "parentTag": "div",
        "tag": "textarea",
        "width": 775.4000244140625,
        "x": 763.1000061035156,
        "y": 603.9000244140625
      },
      "new-chat": {
        "ancestorClasses": [
          "new-dialog-container-plain",
          "new-dialog-container",
          "_chat-aside-header-new-dialog_tnqjy_38",
          "_btn-box_tnqjy_104"
        ],
        "capturedAt": 1795191554586,
        "classes": [
          "cos-line-clamp-1"
        ],
        "docX": 62,
        "docY": 87,
        "height": 20,
        "innerHeight": 703,
        "innerWidth": 1283,
        "parentClasses": [
          "new-dialog-container-plain"
        ],
        "parentTag": "div",
        "tag": "span",
        "text": "新对话",
        "width": 42,
        "x": 62,
        "y": 87
      }
    }
  },
  "network": {
    // 监听经典 conversation 与 agent task_mode 两条端点；经典端还要接受 Search Lightning 的 officeWriting 正文形状。
    "apiPatterns": [
      "https://chat.baidu.com/aichat/api/conversation",
      "https://chat.baidu.com/chat/api/agent/task_mode"
    ]
  },
  "attachment": {
    // file 模式通过 paste 把 .txt 交给编辑器，因为页面没有稳定的文件 input。
    "strategy": "paste",
    "selector": "#chat-textarea"
  },
  "parserRule": {
    // Wenxin (百度文心助手) 有多条聊天端点，每个模式的答案组件不同：经典端点 /aichat/api/conversation 既会返回 `markdown-yiyin|yan`，也会在 Search Lightning 模式切到 `officeWriting.data.content`；新的 agent 端点 /chat/api/agent/task_mode 用 `markdown-yiyan`（另有 `agentProcess` 流承载 agent 的推理过程，目前不映射）。handler 用 `match.urlRegex` 按传输作用域，每个模式的形状显式可读，而不是用正则并集去猜。请求体带完整性校验字段，所以规则同时声明 `request.derive`。
    "schemaVersion": 1,
    "handlers": [
      {
        // Agent 端点（/chat/api/agent/task_mode）：答案是 `markdown-yiyan` generator 的 `data.value` 严格增量帧（实测 19 帧拼出完整 marker 块）。必须用 appendContent：增量里会出现合法重复片段（例如 `\n@@END:`），appendDelta 的「已包含就跳过」会误删 7 个字符。
        "id": "wenxinTaskModeAnswer",
        "match": {
          // 限定 agent task_mode 端点，用 component=markdown-yiyan 识别最终答案，排除 agentProcess 推理流。
          "transport": "sse-json-line",
          "urlRegex": "chat\\.baidu\\.com/chat/api/agent/task_mode",
          "path": "$.data.message.content.generator.component",
          "equals": "markdown-yiyan"
        },
        "content": "$.data.message.content.generator.data.value"
      },
      {
        // Agent 端点收尾：流里出现 `generate-complete`（endTurn=true）表示回答完成；显式声明完成，让规则而不是 socket 关闭来判定这一轮结束。
        "id": "wenxinTaskModeDone",
        "match": {
          // 限定 agent task_mode 端点，用 metaData.state=generate-complete 判定本轮完成。
          "transport": "sse-json-line",
          "urlRegex": "chat\\.baidu\\.com/chat/api/agent/task_mode",
          "path": "$.data.message.metaData.state",
          "equals": "generate-complete"
        },
        "actions": [
          {
            // 将本轮标记为正常结束。
            "op": "setFinishReason",
            "value": "stop"
          }
        ]
      },
      {
        // 经典端点：组件 `markdown-yiy(an|in)` 的 `data.value` 逐片追加（实测 `100 + ` + `100 =` + ` ` + `20`）。
        "id": "wenxinConversationAnswer",
        "match": {
          // 经典端点 `/aichat/api/conversation` 现在也发 `markdown-yiyan`（旧捕获是 `markdown-yiyin`），所以按 `markdown-yiy(an|in)` 收；实测该端点的 value 是纯增量，用 appendContent。
          "transport": "sse-json-line",
          "urlRegex": "chat\\.baidu\\.com/aichat/api/conversation",
          "path": "$.data.message.content.generator.component",
          "regex": "^markdown-yiy(an|in)$"
        },
        "content": "$.data.message.content.generator.data.value"
      },
      {
        // Search Lightning 模式把正文放在 `officeWriting.data.content`，实测 175 个小增量拼出完整 marker（包括 `@@BEG:response@@` 也被拆成多个片段）。这段两套端点都可能出现，因此按组件形状统一接收。
        "id": "wenxinOfficeWritingAnswer",
        "match": {
          // 两套端点都可能进入 Search Lightning，因此按 component=officeWriting 统一识别正文。
          "transport": "sse-json-line",
          "urlRegex": "chat\\.baidu\\.com/(?:aichat/api/conversation|chat/api/agent/task_mode)",
          "path": "$.data.message.content.generator.component",
          "equals": "officeWriting"
        },
        "content": "$.data.message.content.generator.data.content"
      },
      {
        // 经典端点也会以 generate-complete + endTurn=true 收尾；显式设置 finishReason，避免 Search Lightning 等模式白等流关闭。
        "id": "wenxinConversationDone",
        "match": {
          // 限定经典 conversation 端点，用 metaData.state=generate-complete 判定本轮完成。
          "transport": "sse-json-line",
          "urlRegex": "chat\\.baidu\\.com/aichat/api/conversation",
          "path": "$.data.message.metaData.state",
          "equals": "generate-complete"
        },
        "actions": [
          {
            // 将本轮标记为正常结束。
            "op": "setFinishReason",
            "value": "stop"
          }
        ]
      }
    ],
    "request": {
      // 以上路径对应经典端点 /aichat/api/conversation 的请求体形状；新 agent 端点 /chat/api/agent/task_mode 的 body 形状不同（message.inputMethod/content/searchInfo…），inline 模式（请求体改写）需要先对新端点请求体采样再补路径——file/typed 模式不受影响。
      "userText": "$.message.query[?(@.type=='TEXT')][0].data.text.query",
      "derive": [
        {
          // `chat_token` is `base64(...|md5(prompt)|...)` — slot 1 must be recomputed for the rewritten prompt.
          "path": "$.message.searchInfo.chatParams.chat_token",
          "op": "refreshMd5Slot",
          "slot": 1
        },
        {
          // `X-Chat-Message` carries `k:v,k:v` params; the `query` param holds (a prefix of) the prompt and must follow it.
          "header": "X-Chat-Message",
          "op": "refreshHeaderParam",
          "param": "query",
          "slice": 500,
          "pairSep": ",",
          "kvSep": ":"
        }
      ]
    }
  }
}
