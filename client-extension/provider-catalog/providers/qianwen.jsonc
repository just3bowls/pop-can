        ],
        "parentTag": "div",
        "role": "textbox",
        "tag": "div",
        "text": "向千问提问",
        "width": 734.4000244140625,
        "x": 766.5875244140625,
        "y": 304.6499938964844
      },
      "new-chat": {
        "ancestorClasses": [
          "flex",
          "h-full",
          "min-w-0",
          "flex-1",
          "items-center",
          "gap-1.5",
          "rounded-8",
          "px-3",
          "text-sm",
          "text-primary",
          "!transition-colors",
