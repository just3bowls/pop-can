{
  // Qianwen 国内版有两类答案传输：/api/v2/chat SSE 增量快照，以及异步卡片时 /api/v1/chat/snap 轮询快照；规则用 eventsPath 同时覆盖两种形状。
  "schemaVersion": 1,
  "page": {
    // Qianwen 使用 Slate/contenteditable 编辑器，New Chat 在侧栏；fingerprints 用于稳定定位该富文本输入区。
    "url": "https://www.qianwen.com/",
    "selectors": {
      "input": "div[contenteditable=\"true\"][role=\"textbox\"][class*=\"whitespace-pre-wrap\"]",
      "new-chat": "//span[normalize-space()='新对话']"
    },
    "fingerprints": {
      "input": {
        "ancestorClasses": [
          "relative",
          "w-full",
          "flex",
          "shrink-0",
          "flex-col",
          "overflow-hidden",
          "relative",
          "flex",
          "flex-col",
          "transition-[height,max-height,margin]",
          "duration-300",
          "ease-out",
          "overflow-clip"
        ],
        "capturedAt": 1795191554462,
        "classes": [
          "relative",
          "min-h-[24px]",
          "w-full",
          "whitespace-pre-wrap",
          "break-words",
