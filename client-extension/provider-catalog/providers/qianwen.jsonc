          "px-3"
        ],
        "capturedAt": 1795191554462,
        "classes": [
          "truncate",
          "font-400"
        ],
        "docX": 67,
        "docY": 134,
        "height": 20,
        "innerHeight": 703,
        "innerWidth": 1283,
        "parentClasses": [
          "flex",
          "h-full",
          "min-w-0",
          "flex-1",
          "items-center",
          "gap-1.5",
          "rounded-8",
          "px-3",
          "text-sm",
          "text-primary",
          "!transition-colors",
          "!duration-300",
          "hover:bg-option",
          "cursor-pointer"
        ],
        "parentTag": "div",
        "tag": "span",
        "text": "新对话",
        "width": 42,
        "x": 67,
        "y": 134
      }
    }
  },
  "network": {
    // 主响应监听 /api/v2/chat，异步卡片通过 follow-up 端点 /api/v1/chat/snap 补齐；进度条、推荐卡和意图信号都不是正文。
    "apiPatterns": [
      "https://chat2.qianwen.com/api/v2/chat"
    ],
    "followUpPatterns": [
      "/api/v1/chat/snap"
    ],
    "followUpIdentityPath": "$.req_id"
  },
  "attachment": {
    // file 模式使用 paste 向 contenteditable 注入 .txt，因为页面没有稳定的可写 file input。
    "strategy": "paste",
    "selector": "div[contenteditable=\"true\"]"
  },
  "parserRule": {
    // qianwen (domestic, chat2.qianwen.com): the answer always arrives as `multi_load/iframe` messages, but over two transports — the streaming `/api/v2/chat` SSE (one message per `data:` frame, content is a cumulative snapshot) and, when the server switches the turn to an async card, the `/api/v1/chat/snap` snapshot polls (all messages inside one `data.messages[]` array; the complete answer lands in the snapshot whose `is_async_card` finally flips to 0). `eventsPath` fans the message array out so one handler set covers both shapes. Progress bars / follow-up cards / intent signals carry no answer text.
    "schemaVersion": 1,
    "handlers": [
      {
        // Answer text: only `multi_load/iframe` messages carry it; `bar/workflow` is the progress bar, `paa/iframe` / `survey/card` are follow-up cards, `signal/post` is the intent signal.
        "id": "qianwenAnswerText",
        "match": {
          // 展开 messages[] 后只选 mime_type=multi_load/iframe 的答案消息，跳过进度条、推荐卡和意图信号。
          "transport": "sse-json-line",
          "eventsPath": "$.data.messages[*]",
          "path": "$.mime_type",
          "equals": "multi_load/iframe"
        },
        "actions": [
          {
            // appendDelta: content is a cumulative snapshot (SSE: each frame repeats everything so far; snapshot: the final array holds the whole answer), so only the new tail is appended.
            "op": "appendDelta",
            "path": "$.content"
          }
        ]
      },
      {
        // The same message with status=complete: the answer is finished (later frames are only cards), so mark the turn done. On the async-card path this is what closes the follow-up window as soon as the final snapshot lands.
        "id": "qianwenAnswerDone",
        "match": {
          // 在答案消息中再匹配 status=complete，只有终态消息才结束本轮。
          "transport": "sse-json-line",
          "eventsPath": "$.data.messages[*]",
          "path": "$.mime_type",
          "equals": "multi_load/iframe",
          "allOf": [
            {
              // Only the terminal message.
              "path": "$.status",
              "equals": "complete"
            }
          ]
        },
        "actions": [
          {
            // Marks the rule complete; the engine uses it to stop following the follow-up sources.
            "op": "setFinishReason",
            "value": "stop"
          }
        ]
      }
    ],
    "request": {
      // Request body: {"req_id":..,"messages":[{"mime_type":"text/plain","content":"...","meta_data":{"ori_query":"..."}}]}. Both paths hold the user's prompt; rewriting the body keeps them consistent.
      "userText": [
        "$.messages[-1].content",
        "$.messages[-1].meta_data.ori_query"
      ]
    }
  }
}
