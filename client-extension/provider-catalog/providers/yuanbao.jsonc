{
  // Yuanbao SSE：同一端点存在 Hy3、Hy4 agent、DeepSeek 快速和 search_with_text 等多种方言；规则按帧形状匹配，不按 speech_type 能力声明分派。
  "schemaVersion": 1,
  "page": {
    // Yuanbao 使用 Quill ql-editor 富文本输入，New Chat 在会话导航中；fingerprints 依赖编辑器 class 和页面结构。
    "url": "https://yuanbao.tencent.com/chat/",
    "selectors": {
      "input": ".chat-command-editor-specail .ql-editor[contenteditable=\"true\"]",
      "new-chat": ".yb-new-chat-entry__item"
    },
    "fingerprints": {
      "input": {
        "ancestorClasses": [
          "chat-command-editor-specail",
          "InputTextArea_hightLightTextAreaNew__aKxTD",
          "ql-container",
          "flex",
          "w-full",
          "items-start",
          "[&>#search-bar]:!pl-0",
          "min-h-5",
          "px-[6px]"
        ],
        "capturedAt": 1795191556036,
        "classes": [
          "ql-editor",
          "ql-blank"
        ],
        "docX": 768.6000061035156,
        "docY": 586.4000244140625,
        "editable": true,
        "height": 20,
        "innerHeight": 703,
        "innerWidth": 1283,
        "parentClasses": [
          "chat-command-editor-specail",
          "InputTextArea_hightLightTextAreaNew__aKxTD",
          "ql-container"
        ],
        "parentTag": "div",
        "tag": "div",
        "width": 878.4000244140625,
        "x": 768.6000061035156,
        "y": 586.4000244140625
      },
      "new-chat": {
        "ancestorClasses": [
          "yb-new-chat-entry",
          "yb-nav__content",
          "yb-nav__content-wrapper"
        ],
        "ariaLabel": "新建对话",
        "capturedAt": 1795191556036,
        "classes": [
          "yb-new-chat-entry__item"
        ],
        "clickable": true,
        "docX": 130,
        "docY": 78,
        "height": 32,
        "innerHeight": 703,
        "innerWidth": 1283,
        "parentClasses": [
          "yb-new-chat-entry"
        ],
        "parentTag": "div",
        "role": "button",
        "tag": "div",
        "text": "新建对话",
        "width": 232,
        "x": 130,
        "y": 78
      }
    }
  },
  "network": {
    // 监听 /api/chat SSE；meta/chainID 标签在流末尾才出现，不能用于开头模式分派。
    "apiPatterns": [
      "https://yuanbao.tencent.com/api/chat"
    ]
  },
  "attachment": {
    // file 模式使用 paste 把 .txt 交给 ql-editor，因为富文本编辑器通过剪贴板事件接收附件最稳定。
    "strategy": "paste",
    "selector": "div.ql-editor"
  },
  "parserRule": {
    // Yuanbao SSE, one endpoint, several dialects — **不用 mode 分派**：它的 `event: speech_type` 是一串能力声明（实测一轮里出现过 `status` → `search_with_text` → `text` → `hint_v2_tip`，顺序还随模式变），拿第一个非 status 当标签会锁错（2026-10-14 实测：DeepSeek 快速档被锁成 search_with_text，handler 全被跳过、正文 0）。所以改为纯形状匹配：帧级 `type=text` 走 `answerDelta`（$.msg），`deepSearchAgent` 帧的 `contents[].type=text` 走 `agentContent`（$.text）。`meta.chainID` 命名了同一件事（DeepSearch / DeepSeekR1 / WorkingAgentDirect），但它在流末尾才到，也不用于分派。
    "schemaVersion": 1,
    "contentTransforms": [
      {
        // Yuanbao citation markers are display metadata rather than answer text.
        "id": "dropCitationToken",
        "regex": "\\[citation:\\d+\\]",
        "replacement": "",
        "settle": {
          "candidatePrefix": "[citation:"
        }
      },
      {
        // Yuanbao emits source-underline metadata as [](@name=value) tokens.
        "id": "dropUnderlineToken",
        "regex": "\\[\\]\\(@[a-zA-Z_]+=[^)]+\\)",
        "replacement": "",
        "settle": {
          "candidatePrefix": "[](@"
        }
      }
    ],
    "handlers": [
      {
        // 经典方言（Hy3 / Hy3 深度思考 / DeepSeek 快速档 / search_with_text 档等）：答案走 `{"type":"text","msg":…}`。
        "id": "answerDelta",
        "match": {
          // 帧级 `$.type=text` 且带 `$.msg`；agent 方言的帧级 type 是 deepSearchAgent，天然不会被收。
          "transport": "sse-json-line",
          "path": "$.type",
          "equals": "text"
        },
        "content": "$.msg"
      },
      {
        // agent 方言（Hy4 preview / OneAgent）：one contents[] item per frame，type=text 是答案，type=think 是页面自己的思考。
        "id": "agentContent",
        "match": {
          // 帧级正则要求 deepSearchAgent（classic 帧没有 contents，本 handler 不会收）。
          "transport": "sse-json-line",
          "eventsPath": "$.contents[*]",
          "path": "$.type",
          "equals": "text"
        },
        "content": "$.text"
      },
      {
        // type=meta with stopReason=stop — the server finished this answer.
        "id": "messageMeta",
        "match": {
          // 匹配最终 meta 帧中的 stopReason=stop，不把中途能力声明或 agent 状态当作结束。
          "transport": "sse-json-line",
          "path": "$.stopReason",
          "equals": "stop"
        },
        "actions": [
          {
            // 将本轮标记为正常结束。
            "op": "setFinishReason",
            "value": "stop"
          }
        ]
      }
    ],
    "request": {
      // inline 模式同时改写 $.prompt 与 $.displayPrompt，保持真实请求字段和页面显示文本一致。
      "userText": [
        "$.prompt",
        "$.displayPrompt"
      ]
    }
  }
}
