{
  // GLM 网页 SSE：正文按增量输出，但 status=finish 帧会重复完整答案；规则用 appendDelta 吸收最终快照，并过滤页面渲染用的 turn/citation token。
  "schemaVersion": 2,
  "name": "gml",
  "page": {
    // 输入框是 composer textarea，附件入口暴露 input.el-upload__input，New Chat 在页面主区域；fingerprints 用于校准文本框与新建对话入口。
    "url": "https://chatglm.cn/main/alltoolsdetail?t=1788611652123&lang=zh",
    "selectors": {
      "input": "/*[local-name()='html']/*[local-name()='body'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='section'][1]/*[local-name()='main'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][5]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][2]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][3]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='textarea'][1]",
      "new-chat": "/*[local-name()='html']/*[local-name()='body'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='section'][1]/*[local-name()='aside'][1]/*[local-name()='div'][2]/*[local-name()='div'][1]/*[local-name()='div'][1]"
    },
    "fingerprints": {
