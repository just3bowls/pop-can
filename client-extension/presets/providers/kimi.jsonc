{
  // Kimi 使用 gRPC-Web 帧承载 JSON operation log；规则识别 text block 的 set/append、message completed、done 与 provider error 控制帧。
  "schemaVersion": 2,
  "name": "kimi",
  "page": {
    // Kimi 的编辑器是 contenteditable，New Chat 在侧栏；fingerprints 依赖编辑器角色与页面布局，而不是容易变化的深层节点序号。
    "url": "https://www.kimi.com/",
    "selectors": {
      "input": "/*[local-name()='html']/*[local-name()='body'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][2]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][2]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][3]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][2]/*[local-name()='div'][2]",
      "new-chat": "/*[local-name()='html']/*[local-name()='body'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='div'][1]/*[local-name()='aside'][1]/*[local-name()='div'][2]/*[local-name()='a'][1]"
    },
    "fingerprints": {
